import aktual.budget.model.CategoryGroupId;
import aktual.budget.model.CategoryId;
import aktual.budget.model.CleanupTemplate;
import kotlin.Boolean;
import kotlin.collections.List;
import kotlinx.serialization.json.JsonElement;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE IF NOT EXISTS categories(
  id TEXT AS CategoryId PRIMARY KEY,
  name TEXT,
  is_income INTEGER AS Boolean DEFAULT 0,
  cat_group TEXT AS CategoryGroupId,
  sort_order REAL,
  tombstone INTEGER AS Boolean DEFAULT 0,
  hidden INTEGER AS Boolean NOT NULL DEFAULT 0,
  goal_def TEXT AS JsonElement DEFAULT NULL,
  template_settings TEXT AS JsonObject DEFAULT '{"source": "notes"}',
  cleanup_def TEXT AS List<CleanupTemplate> DEFAULT NULL
);

CREATE VIEW IF NOT EXISTS v_categories AS
  SELECT
    id,
    name,
    is_income,
    hidden,
    cat_group AS "group",
    sort_order,
    tombstone
  FROM categories;

insert: INSERT INTO categories VALUES ?;

getName: SELECT name FROM categories WHERE id = ?;

-- packages/loot-core/src/server/accounts/payees.ts getStartingBalancePayee()
getStartingBalancesCategory:
SELECT id FROM categories
  WHERE is_income = 1 AND LOWER(name) = 'starting balances' AND tombstone = 0
  LIMIT 1;

getFirstIncomeCategory:
SELECT id FROM categories WHERE is_income = 1 AND tombstone = 0 LIMIT 1;

getNames: SELECT name FROM categories WHERE id IN ?;

getAllActive: SELECT id, name FROM categories WHERE tombstone = 0 AND hidden = 0 ORDER BY sort_order, name;

-- Visible categories under their groups, in the order upstream's category picker lists them
getAllActiveGrouped:
SELECT c.id, c.name, g.id AS groupId, g.name AS groupName
  FROM categories c
  LEFT JOIN category_groups g ON g.id = c.cat_group
  WHERE c.tombstone = 0 AND c.hidden = 0 AND IFNULL(g.tombstone, 0) = 0 AND IFNULL(g.hidden, 0) = 0
  ORDER BY g.is_income, g.sort_order, g.id, c.sort_order, c.id;

isIncome: SELECT is_income FROM categories WHERE id = ?;

categories:
  SELECT *
    FROM categories
    WHERE tombstone = 0
    ORDER BY sort_order, id;
