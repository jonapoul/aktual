flowchart TD
  app["Open App"]
  budgetList["List Budgets"]
  budgetSync["Sync Budget"]
  info["About"]
  licenses["Licenses"]
  login["Login"]
  manageStorage["Manage Storage"]
  password["Change Password"]
  settings["Settings"]
  scheduleSettings["Schedule Settings"]
  url["Server URL"]

  subgraph budgetNavRail["Budget Nav Rail"]
    transactions["Transactions"]
    reportsDashboard["Reports Dashboard"]
    report["Report"]
    createReport["Create Report"]
    searchReports["Search Reports"]
    listTags["List Tags"]
    createTag["Create Tag"]
    editTag["Edit Tag"]
    searchTags["Search Tags"]
    listSchedules["List Schedules"]
    editSchedule["Edit Schedule"]
    searchSchedules["Search Schedules"]
    bankSync["Bank Sync"]
    bankSyncSettings["Bank Sync Settings"]
    linkBankAccount["Link Bank Account"]
  end

  app --valid token--> budgetList
  app --"valid token + last opened budget with local files"--> budgetNavRail
  app --no token--> login
  app --no token, no url--> url

  budgetList --tap budget - unsynced--> budgetSync
  budgetList --tap budget - synced--> budgetNavRail
  budgetList --tap change password--> password
  budgetList --tap settings--> settings
  budgetList --tap change url--> url
  budgetList --tap about--> info

  settings --tap schedules--> scheduleSettings

  budgetSync --budget synced--> budgetNavRail

  info --tap licenses--> licenses
  info --tap manage storage--> manageStorage

  login --valid token--> budgetList
  login --tap about--> info
  login --tap change url--> url

  url --tap try demo--> budgetNavRail

  budgetNavRail --back--> budgetList
  budgetNavRail --tap exit demo--> url
  budgetNavRail --tap about--> info

  reportsDashboard --tap report--> report
  reportsDashboard --tap create--> createReport
  reportsDashboard --tap search--> searchReports
  searchReports --tap report--> report

  listTags --tap add--> createTag
  listTags --tap tag--> editTag
  listTags --tap search--> searchTags
  searchTags --tap tag--> editTag

  listSchedules --tap schedule--> editSchedule
  listSchedules --tap search--> searchSchedules
  listSchedules --tap settings--> scheduleSettings
  searchSchedules --tap schedule--> editSchedule

  bankSync --tap linked account--> bankSyncSettings
  bankSync --tap unlinked account--> linkBankAccount
