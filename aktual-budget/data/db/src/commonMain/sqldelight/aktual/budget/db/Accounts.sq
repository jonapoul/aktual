import aktual.budget.model.AccountGroupId;
import aktual.budget.model.AccountId;
import aktual.budget.model.AccountSyncSource;
import aktual.budget.model.Amount;
import aktual.budget.model.BankSyncStatus;
import kotlin.Boolean;
import kotlin.uuid.Uuid;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS accounts(
  id TEXT AS AccountId PRIMARY KEY,
  account_id TEXT,
  name TEXT,
  balance_current INTEGER AS Amount,
  balance_available INTEGER AS Amount,
  balance_limit INTEGER AS Amount,
  mask TEXT,
  official_name TEXT,
  subtype TEXT,
  bank TEXT AS Uuid,
  offbudget INTEGER AS Boolean DEFAULT 0,
  closed INTEGER AS Boolean DEFAULT 0,
  tombstone INTEGER AS Boolean DEFAULT 0,
  sort_order REAL,
  type TEXT,
  account_sync_source TEXT AS AccountSyncSource,
  last_sync TEXT AS Instant,
  last_reconciled TEXT AS Instant,
  bank_sync_status TEXT AS BankSyncStatus,
  account_group_id TEXT AS AccountGroupId DEFAULT NULL
);

getById: SELECT * FROM accounts WHERE id = ? LIMIT 1;

getBankSyncStatus: SELECT bank_sync_status FROM accounts WHERE id = ?;

getAccountGroupId: SELECT account_group_id FROM accounts WHERE id = ?;

-- packages/loot-core/src/server/accounts/sync.ts updateAccountBalance()
updateBalance: UPDATE accounts SET balance_current = ? WHERE id = ?;

closeAccount: UPDATE accounts SET closed = 1 WHERE id = ?;

getName: SELECT name FROM accounts WHERE id = ?;

getNames: SELECT name FROM accounts WHERE id IN ?;

getAllActive: SELECT id, name FROM accounts WHERE tombstone = 0 AND closed = 0 ORDER BY sort_order, name;

getAllNames: SELECT id, name FROM accounts WHERE tombstone = 0;

-- Including closed accounts, so something linked to one can still name it
getAllWithStatus:
SELECT id, name, closed, offbudget FROM accounts WHERE tombstone = 0 ORDER BY sort_order, name;

-- Every account with its current balance, closed ones included. As upstream's sidebar, the balance
-- sums every live transaction, future-dated too, skipping split children since their parent's
-- amount already covers them. last_activity is the date of the account's latest transaction
-- packages/desktop-client/src/spreadsheet/bindings.ts accountBalance()
getAllWithBalances:
SELECT a.id, a.name, a.offbudget, a.closed, a.account_sync_source, a.account_id,
    a.bank_sync_status, a.last_sync, CAST(IFNULL(SUM(t.amount), 0) AS INTEGER) AS balance,
    MAX(t.date) AS last_activity
  FROM accounts a
  LEFT JOIN v_transactions_internal_alive t ON t.account = a.id AND IFNULL(t.is_child, 0) = 0
  WHERE a.tombstone = 0
  GROUP BY a.id
  ORDER BY a.sort_order, a.name;

-- Open accounts with their linked bank's name, for the bank sync screen
-- packages/desktop-client/src/components/mobile/banksync/MobileBankSyncPage.tsx
getBankSyncAccounts:
SELECT a.id, a.name, a.account_id, a.account_sync_source, a.last_sync, a.bank_sync_status,
    b.name AS bank_name
  FROM accounts a
  LEFT JOIN banks b ON a.bank = b.id AND b.tombstone = 0
  WHERE a.tombstone = 0 AND a.closed = 0
  ORDER BY a.sort_order, a.name;

-- packages/loot-core/src/server/db/index.ts insertAccount(), which appends to its on/off budget list.
-- Unlike upstream, deleted accounts are skipped
getMaxSortOrder:
SELECT MAX(sort_order) AS sort_order FROM accounts WHERE offbudget = ? AND tombstone = 0;

insert:
INSERT INTO accounts(id, account_id, name, official_name, bank, offbudget, account_sync_source)
  VALUES (?, ?, ?, ?, ?, ?, ?);
