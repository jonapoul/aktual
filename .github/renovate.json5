{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "github>jonapoul/renovate-config:default.json5"
  ],
  "customManagers": [
    {
      // Atlas downloads this d2 version. Pinned so CI renders the same PNGs that were committed.
      "customType": "regex",
      "managerFilePatterns": [
        "/^gradle\\.properties$/",
      ],
      "matchStrings": [
        "atlas\\.d2\\.version=(?<currentValue>\\S+)",
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "d2lang/d2",
      // D2 tags its releases with a v prefix
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
  ],
  "packageRules": [
    // TBC
  ]
}
