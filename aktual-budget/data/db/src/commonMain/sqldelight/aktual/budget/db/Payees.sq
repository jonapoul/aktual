import aktual.budget.model.AccountId;
import aktual.budget.model.PayeeId;
import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS payees(
  id TEXT AS PayeeId PRIMARY KEY,
  name TEXT,
  category TEXT, -- unused
  tombstone INTEGER AS Boolean DEFAULT 0,
  transfer_acct TEXT AS AccountId,
  favorite INTEGER AS Boolean DEFAULT 0 DEFAULT FALSE,
  learn_categories INTEGER DEFAULT 1
);

CREATE VIEW IF NOT EXISTS v_payees AS SELECT
  p.id,
  COALESCE(a.name, p.name) AS name,
  p.transfer_acct,
  p.tombstone,
  p.favorite
FROM payees p
LEFT JOIN accounts
  a ON (p.transfer_acct = a.id AND a.tombstone = 0)
  -- We never want to show transfer payees that are pointing to deleted accounts.
  -- Either this is not a transfer payee, if the account exists
WHERE p.transfer_acct IS NULL OR a.id IS NOT NULL;

getAllActive: SELECT id, name FROM v_payees WHERE tombstone = 0 ORDER BY name;

-- The payees screen's list, named as v_payees names them, with how many transactions use each. A
-- split counts once. Reads the tables directly since v_payees has no learn_categories
getPayeeList:
SELECT
  p.id,
  COALESCE(a.name, p.name) AS name,
  p.transfer_acct,
  p.favorite,
  p.learn_categories,
  COALESCE(c.num_transactions, 0) AS num_transactions
FROM payees p
LEFT JOIN accounts a ON (p.transfer_acct = a.id AND a.tombstone = 0)
LEFT JOIN (
  SELECT payee, COUNT(DISTINCT COALESCE(parent_id, id)) AS num_transactions
    FROM v_transactions_internal_alive
    GROUP BY payee
) c ON c.payee = p.id
WHERE p.tombstone = 0 AND (p.transfer_acct IS NULL OR a.id IS NOT NULL)
ORDER BY name COLLATE NOCASE;

-- With the account each transfer payee stands in for
getAllWithTransfer:
SELECT id, name, transfer_acct, favorite FROM v_payees WHERE tombstone = 0 ORDER BY name;

-- db/index.ts getCommonPayees(): the payees used most since a date. Upstream's transfer payees
-- have no name of their own, so they're never among them
getCommon:
SELECT p.id, p.name
  FROM payees p
  INNER JOIN v_transactions_internal_alive t ON t.payee = p.id
  WHERE LENGTH(p.name) > 0 AND p.tombstone = 0 AND p.transfer_acct IS NULL AND t.date > :since
  GROUP BY p.id
  ORDER BY COUNT(*) DESC, p.name COLLATE NOCASE
  LIMIT :limit;

-- transactions/transfer.ts getTransferredAccount(), with the payee resolved through payee_mapping
-- as the transaction views do
getTransferAccount:
SELECT transfer_acct
  FROM v_payees
  WHERE id = COALESCE((SELECT targetId FROM payee_mapping WHERE id = :id), :id);

-- transactions/transfer.ts getPayee()
getTransferPayee: SELECT id FROM payees WHERE transfer_acct = ? LIMIT 1;

getById: SELECT * FROM payees WHERE id = ? LIMIT 1;

-- packages/loot-core/src/server/accounts/payees.ts createPayee(). Upstream compares with
-- UNICODE_LOWER, which SQLite doesn't have, so callers compare the names themselves
getAliveIdsAndNames: SELECT id, name FROM payees WHERE tombstone = 0;

getName:
  SELECT name
    FROM v_payees
    WHERE id = COALESCE((SELECT targetId FROM payee_mapping WHERE id = :id), :id);

getNames: SELECT name FROM v_payees WHERE id IN ?;

setNameAndFavorite: UPDATE payees SET name = :name, favorite = :favorite WHERE id = :id;

insert:
  INSERT OR REPLACE
    INTO payees(id, name, category, tombstone, transfer_acct, favorite, learn_categories)
    VALUES(?,?,?,?,?,?,?);
