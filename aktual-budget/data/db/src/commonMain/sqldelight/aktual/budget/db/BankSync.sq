-- Lookups for bank sync, see aktual-budget:banksync:domain. The views don't carry raw_synced_data,
-- and SQLDelight can't type the computed parent_id of v_transactions_internal, so both come from
-- the joined transactions row

-- packages/loot-core/src/server/accounts/sync.ts matchTransactions(), when deleted transactions
-- are reimported
bankSyncMatchAlive:
SELECT v.id, v.is_parent, v.date, v.payee, v.category, v.notes, v.imported_id, v.imported_payee,
  v.cleared, v.reconciled, t.raw_synced_data
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE v.imported_id = :importedId AND v.account = :account
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id
LIMIT 1;

-- As above, but deleted transactions match too and so aren't reimported. SQLDelight can't type the
-- view's computed category either, so it's mapped here and cleared for split parents by the caller
bankSyncMatchAny:
SELECT v.id, v.is_parent, v.date, v.payee, cm.transferId AS category, v.notes, v.imported_id,
  v.imported_payee, v.cleared, v.reconciled, t.raw_synced_data
FROM v_transactions_internal v
JOIN transactions t ON t.id = v.id
LEFT JOIN category_mapping cm ON cm.id = t.category
WHERE v.imported_id = :importedId AND v.account = :account
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id
LIMIT 1;

-- The fuzzy match candidates of matchTransactions(), with strictIdChecking. Transactions that
-- already have an imported_id only match one that doesn't. As upstream, raw_synced_data isn't read
bankSyncFuzzyCandidatesStrict:
SELECT v.id, v.is_parent, t.isChild, t.parent_id, v.date, v.payee, v.category, v.notes,
  v.imported_id, v.imported_payee, v.cleared, v.reconciled
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE
  v.imported_id IS NULL
  AND v.date >= :from AND v.date <= :to AND v.amount = :amount
  AND v.account = :account
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id;

-- As above, without strictIdChecking
bankSyncFuzzyCandidates:
SELECT v.id, v.is_parent, t.isChild, t.parent_id, v.date, v.payee, v.category, v.notes,
  v.imported_id, v.imported_payee, v.cleared, v.reconciled
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE v.date >= :from AND v.date <= :to AND v.amount = :amount AND v.account = :account
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id;

-- reconcileTransactions(): SELECT id FROM v_transactions WHERE parent_id = ?
bankSyncChildIds:
SELECT v.id
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE v.is_child = 1 AND t.parent_id = :parent;

-- packages/loot-core/src/server/db/index.ts getCategories()
bankSyncCategoryIds:
SELECT id FROM categories WHERE tombstone = 0;

-- packages/loot-core/src/server/accounts/app.ts accountsBankSync(). Only open accounts with both
-- a linked bank and the provider's account ID are synced
bankSyncAccounts:
SELECT a.id, a.name, a.account_id, a.account_sync_source, b.bank_id, b.name AS bank_name
FROM accounts a
JOIN banks b ON a.bank = b.id
WHERE
  a.tombstone = 0 AND a.closed = 0
  AND a.account_id IS NOT NULL AND a.account_id != ''
  AND b.bank_id IS NOT NULL AND b.bank_id != ''
ORDER BY a.offbudget, a.sort_order;

-- packages/loot-core/src/server/accounts/sync.ts getAccountOldestTransaction()
bankSyncOldestDate:
SELECT date FROM v_transactions WHERE account = :account AND date <= :today ORDER BY date LIMIT 1;

-- useBankSyncAccountSettings(): the downloaded data of the account's newest synced payment, which
-- offers the fields its payments can be mapped from
bankSyncPaymentExample:
SELECT t.raw_synced_data
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE v.account = :account AND v.amount <= 0 AND t.raw_synced_data IS NOT NULL
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id
LIMIT 1;

-- As above, for deposits
bankSyncDepositExample:
SELECT t.raw_synced_data
FROM v_transactions v
JOIN transactions t ON t.id = v.id
WHERE v.account = :account AND v.amount > 0 AND t.raw_synced_data IS NOT NULL
ORDER BY v.date DESC, v.starting_balance_flag, v.sort_order DESC, v.id
LIMIT 1;

-- packages/loot-core/src/server/accounts/link.ts findOrCreateBank(). IS so that banks without an
-- ID or name still match. Upstream compares bank_id with =, so it never reuses a bank without an ID
bankSyncFindBank:
SELECT id FROM banks WHERE bank_id IS :bankId AND name IS :name LIMIT 1;

-- unlinkAccount(): how many accounts still use a bank, deleted ones included as upstream
bankSyncBankUsers:
SELECT COUNT(*) FROM accounts WHERE bank = :bank;
