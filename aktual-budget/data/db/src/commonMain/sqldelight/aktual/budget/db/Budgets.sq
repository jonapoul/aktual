-- packages/loot-core/src/server/budget/base.ts createAllBudgets()
-- Deleted transactions count too, as upstream
budgetEarliestTransactionDate:
SELECT MIN(date) AS date FROM transactions WHERE isChild = 0 AND date IS NOT NULL;

-- packages/loot-core/src/server/budget/base.ts createBudget()
budgetCategories:
SELECT
  c.id,
  c.name,
  c.is_income,
  c.hidden,
  g.id AS group_id,
  g.is_income AS group_is_income,
  g.hidden AS group_hidden
FROM categories c
JOIN category_groups g ON g.id = c.cat_group AND g.tombstone = 0
WHERE c.tombstone = 0
ORDER BY g.is_income, g.sort_order, g.id, c.sort_order, c.id;

-- packages/loot-core/src/server/budget/base.ts createBudget()
budgetCategoryGroups:
SELECT id, name, is_income, hidden, sort_order
FROM category_groups
WHERE tombstone = 0
ORDER BY is_income, sort_order, id;

-- packages/loot-core/src/server/budget/base.ts getSumAmountsByMonth()
budgetSpentByMonth:
SELECT
  c.id AS category,
  CAST(t.date / 100 AS INTEGER) AS month,
  CAST(IFNULL(SUM(t.amount), 0) AS INTEGER) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
JOIN categories c ON c.id = t.category
WHERE t.date >= :start AND t.date <= :end AND a.offbudget = 0
GROUP BY c.id, month;

-- packages/loot-core/src/server/sheet.ts loadUserBudgets()
zeroBudgets:
SELECT b.month, c.id AS category, b.amount, IFNULL(b.carryover, 0) = 1 AS carryover
FROM zero_budgets b
JOIN categories c ON c.id = b.category AND c.tombstone = 0
WHERE b.month >= :start AND b.month <= :end;

reflectBudgets:
SELECT b.month, c.id AS category, b.amount, IFNULL(b.carryover, 0) = 1 AS carryover
FROM reflect_budgets b
JOIN categories c ON c.id = b.category AND c.tombstone = 0
WHERE b.month >= :start AND b.month <= :end;

zeroBudgetMonths:
SELECT id, buffered FROM zero_budget_months;

-- packages/loot-core/src/server/budget/actions.ts setBudget() and setCarryover()
zeroBudgetRow:
SELECT id, amount, carryover FROM zero_budgets WHERE month = :month AND category = :category LIMIT 1;

reflectBudgetRow:
SELECT id, amount, carryover FROM reflect_budgets WHERE month = :month AND category = :category LIMIT 1;

-- packages/loot-core/src/server/budget/actions.ts getBudgetData()
zeroBudgetsInMonth:
SELECT b.category, b.amount, c.is_income, c.hidden, g.hidden AS group_hidden
FROM zero_budgets b
LEFT JOIN categories c ON b.category = c.id
LEFT JOIN category_groups g ON c.cat_group = g.id
WHERE c.tombstone = 0 AND b.month = :month;

reflectBudgetsInMonth:
SELECT b.category, b.amount, c.is_income, c.hidden, g.hidden AS group_hidden
FROM reflect_budgets b
LEFT JOIN categories c ON b.category = c.id
LEFT JOIN category_groups g ON c.cat_group = g.id
WHERE c.tombstone = 0 AND b.month = :month;

-- packages/loot-core/src/server/budget/actions.ts getFirstActivityMonth()
zeroBudgetFirstActivity:
SELECT MIN(month) AS month
FROM (
  SELECT CAST(month AS INTEGER) AS month FROM zero_budgets WHERE category = :category AND month <= :end
  UNION ALL
  SELECT CAST(t.date / 100 AS INTEGER) AS month
  FROM v_transactions_internal_alive t
  LEFT JOIN accounts a ON a.id = t.account
  WHERE t.category = :category AND CAST(t.date / 100 AS INTEGER) <= :end AND a.offbudget = 0
);

reflectBudgetFirstActivity:
SELECT MIN(month) AS month
FROM (
  SELECT CAST(month AS INTEGER) AS month FROM reflect_budgets WHERE category = :category AND month <= :end
  UNION ALL
  SELECT CAST(t.date / 100 AS INTEGER) AS month
  FROM v_transactions_internal_alive t
  LEFT JOIN accounts a ON a.id = t.account
  WHERE t.category = :category AND CAST(t.date / 100 AS INTEGER) <= :end AND a.offbudget = 0
);
