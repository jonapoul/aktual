{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "github>jonapoul/renovate-config:default.json5"
  ],
  "packageRules": [
    {
      // AGP versions are hardcoded in settings.gradle.kts as well as the version catalog, so
      // force them into the same group as the catalog's "agp" version ref. Listed explicitly
      // because com.android.* would also swallow com.android.tools:desugar_jdk_libs
      "matchDepNames": [
        "com.android.application",
        "com.android.kotlin.multiplatform.library",
        "com.android.lint"
      ],
      "groupName": "AGP"
    },
    {
      // Same for blueprint, which is also referenced by the detekt-rules artifact in the catalog
      "matchDepNames": [
        "dev.jonpoulton.blueprint*"
      ],
      "groupName": "blueprint"
    },
    {
      // Same for Kotlin. Two globs so we catch plugin IDs and artifacts, but not org.jetbrains.kotlinx
      "matchDepNames": [
        "org.jetbrains.kotlin.*",
        "org.jetbrains.kotlin:*"
      ],
      "groupName": "kotlin"
    }
  ]
}
