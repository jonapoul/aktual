import aktual.budget.model.CategoryGroupId;
import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS category_groups(
  id TEXT AS CategoryGroupId PRIMARY KEY,
  name TEXT,
  is_income INTEGER AS Boolean DEFAULT 0,
  sort_order REAL,
  tombstone INTEGER AS Boolean DEFAULT 0,
  hidden INTEGER AS Boolean NOT NULL DEFAULT 0
);

getName: SELECT name FROM category_groups WHERE id = ?;

getNames: SELECT name FROM category_groups WHERE id IN ?;

getAllActive: SELECT id, name FROM category_groups WHERE tombstone = 0 AND hidden = 0 ORDER BY sort_order, name;
