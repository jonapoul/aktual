import aktual.budget.model.PayeeId;
import aktual.budget.model.PayeeLocationId;
import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS payee_locations(
  id TEXT AS PayeeLocationId PRIMARY KEY,
  payee_id TEXT AS PayeeId,
  latitude REAL,
  longitude REAL,
  created_at INTEGER AS Instant,
  tombstone INTEGER AS Boolean DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_payee_locations_payee_id ON payee_locations (payee_id);

CREATE INDEX IF NOT EXISTS idx_payee_locations_tombstone_payee_created ON payee_locations (tombstone, payee_id, created_at);

CREATE INDEX IF NOT EXISTS idx_payee_locations_geo_tombstone ON payee_locations (tombstone, latitude, longitude);

getForPayee:
  SELECT id, latitude, longitude, created_at
  FROM payee_locations
  WHERE tombstone IS NOT 1 AND payee_id = ?
  ORDER BY created_at DESC;

getAllWithPayee:
  SELECT pl.id, pl.payee_id, COALESCE(a.name, p.name) AS payee_name, pl.latitude, pl.longitude, pl.created_at
  FROM payee_locations pl
  JOIN payees p ON pl.payee_id = p.id
  LEFT JOIN accounts a ON (p.transfer_acct = a.id AND a.tombstone = 0)
  WHERE pl.tombstone IS NOT 1 AND p.tombstone IS NOT 1
  ORDER BY payee_name COLLATE NOCASE, pl.created_at DESC;

-- A box around a point, since SQLite has no trig functions to measure distance with
getInBounds:
  SELECT pl.id, pl.payee_id, pl.latitude, pl.longitude
  FROM payee_locations pl
  JOIN payees p ON pl.payee_id = p.id
  WHERE pl.tombstone IS NOT 1
    AND p.tombstone IS NOT 1
    AND pl.latitude BETWEEN :minLatitude AND :maxLatitude
    AND pl.longitude BETWEEN :minLongitude AND :maxLongitude;

insert:
  INSERT INTO payee_locations (id, payee_id, latitude, longitude, created_at, tombstone)
  VALUES (?, ?, ?, ?, ?, ?);
