    <item quantity="one">%1$d scheduled transaction included</item>
    <item quantity="other">%1$d scheduled transactions included</item>
  </plurals>
  <string name="reports_balance_forecast_no_scheduled">No scheduled transactions in this range</string>
  <string name="reports_balance_forecast_tracking">Forecast = starting balance + budgeted income - budgeted expenses</string>
  <string name="reports_balance_forecast_how_title">How is the forecast calculated?</string>
  <string name="reports_balance_forecast_how">This forecast shows your running balance from posted transactions, plus upcoming scheduled transactions in the future. Recurring schedules are repeated up to the end of the range, and transfer schedules move money between both accounts. The forecast is only as accurate as your schedules.</string>
  <string name="reports_balance_forecast_tracking_how">The tracking budget forecast starts from your on-budget balance, then adds each month’s budgeted income and subtracts its budgeted expenses. It doesn’t use schedules or account filters.</string>

