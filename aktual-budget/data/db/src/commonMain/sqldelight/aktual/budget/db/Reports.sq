-- packages/loot-core/src/server/transactions/app.ts getEarliestTransaction() / getLatestTransaction()
transactionDateBounds:
SELECT MIN(date) AS earliest, MAX(date) AS latest
FROM v_transactions_internal_alive
WHERE is_child = 0;

-- packages/desktop-client/src/components/reports/spreadsheets/cash-flow-spreadsheet.tsx cashFlowByDate()
cashFlowStartingBalance:
SELECT IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
WHERE t.is_parent = 0 AND a.offbudget = 0 AND t.date < :start;

cashFlowByMonth:
SELECT
  CAST(t.date / 100 AS INTEGER) AS month,
  p.transfer_acct IS NOT NULL AS is_transfer,
  t.amount > 0 AS is_income,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
LEFT JOIN payees p ON p.id = t.payee
WHERE t.is_parent = 0 AND a.offbudget = 0 AND t.amount != 0 AND t.date >= :start AND t.date <= :end
GROUP BY month, is_transfer, is_income;

-- packages/desktop-client/src/components/reports/spreadsheets/net-worth-spreadsheet.ts createSpreadsheet()
netWorthStartingBalance:
SELECT IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0
WHERE t.is_parent = 0 AND t.date < :start;

netWorthByMonth:
SELECT
  CAST(t.date / 100 AS INTEGER) AS month,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0
WHERE t.is_parent = 0 AND t.date >= :start AND t.date <= :end
GROUP BY month;

-- packages/desktop-client/src/components/reports/spreadsheets/age-of-money-spreadsheet.ts createAgeOfMoneySpreadsheet()
-- Transfers between on-budget accounts just move money around the pool, so they're left out
ageOfMoneyTransactions:
SELECT t.date, t.amount
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
LEFT JOIN payees p ON p.id = t.payee
LEFT JOIN accounts ta ON ta.id = p.transfer_acct
WHERE t.is_parent = 0 AND a.offbudget = 0 AND t.amount != 0 AND t.date <= :end
  AND (p.transfer_acct IS NULL OR ta.offbudget = 1)
ORDER BY t.date;

-- packages/desktop-client/src/components/reports/spreadsheets/crossover-spreadsheet.ts createCrossoverSpreadsheet()
crossoverExpensesByMonth:
SELECT
  CAST(t.date / 100 AS INTEGER) AS month,
  c.id AS category,
  c.is_income,
  c.hidden,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN categories c ON c.id = t.category AND c.tombstone = 0
WHERE t.is_parent = 0 AND t.date >= :start AND t.date <= :end
GROUP BY month, c.id;

crossoverStartingBalances:
SELECT
  a.id AS account,
  a.tombstone,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
WHERE t.is_parent = 0 AND t.date < :start
GROUP BY a.id;

crossoverBalancesByMonth:
SELECT
  CAST(t.date / 100 AS INTEGER) AS month,
  a.id AS account,
  a.tombstone,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
WHERE t.is_parent = 0 AND t.date >= :start AND t.date <= :end
GROUP BY month, a.id;

-- packages/desktop-client/src/components/reports/spreadsheets/sankey-spreadsheet.ts fetchCategoryData()
sankeyCategoryTotals:
SELECT
  c.id AS category,
  c.name AS category_name,
  c.sort_order AS category_sort_order,
  g.id AS category_group,
  g.name AS group_name,
  g.sort_order AS group_sort_order,
  g.is_income,
  a.id AS account,
  a.name AS account_name,
  p.id AS payee,
  p.name AS payee_name,
  IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN categories c ON c.id = t.category AND c.tombstone = 0
JOIN category_groups g ON g.id = c.cat_group AND g.tombstone = 0
JOIN accounts a ON a.id = t.account AND a.tombstone = 0
LEFT JOIN payees p ON p.id = t.payee AND p.tombstone = 0
WHERE t.is_parent = 0 AND t.date >= :start AND t.date <= :end
GROUP BY c.id, a.id, p.id;

-- packages/desktop-client/src/components/reports/spreadsheets/sankey-spreadsheet.ts fetchTransferData()
sankeyTransfers:
SELECT t.id, t.amount, a.id AS account, a.name AS account_name, t.transfer_id
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0 AND a.offbudget = 0
WHERE t.is_parent = 0 AND t.transfer_id IS NOT NULL AND t.date >= :start AND t.date <= :end;

-- packages/loot-core/src/server/forecast/forecast-accounts.ts getAccounts()
forecastAccounts:
SELECT id
FROM accounts
WHERE tombstone = 0;

-- packages/loot-core/src/server/forecast/forecast-projection.ts summarizePostedTransactions()
forecastStartingBalances:
SELECT a.id AS account, IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0
WHERE t.is_parent = 0 AND t.date < :start
GROUP BY a.id;

forecastDailyTotals:
SELECT a.id AS account, t.date, IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0
WHERE t.is_parent = 0 AND t.date >= :start AND t.date <= :end
GROUP BY a.id, t.date;

-- packages/loot-core/src/server/forecast/forecast-schedules.ts getSchedules()
forecastSchedules:
SELECT id, name, next_date, posts_transaction, _payee, _account, _amount, _date, _conditions
FROM v_schedules
WHERE tombstone = 0 AND completed = 0;

-- packages/loot-core/src/shared/schedules.ts isScheduleOccurrencePosted()
-- Split parents are kept too, so a posted split is found whichever row links the schedule
forecastPostedScheduleTransactions:
SELECT t.schedule, t.account, t.date
FROM v_transactions_internal_alive t
WHERE t.schedule IS NOT NULL AND t.date >= :start;

forecastTransferPayees:
SELECT id, transfer_acct
FROM payees
WHERE transfer_acct IS NOT NULL;

-- packages/loot-core/src/server/forecast/forecast-tracking-budget.ts projectTrackingBudgetForecast()
forecastOnBudgetBalance:
SELECT IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account AND a.tombstone = 0 AND a.offbudget = 0
WHERE t.is_parent = 0;

-- packages/loot-core/src/server/budget/tracking.ts createSummary() total-budget-income and total-budgeted
forecastTrackingBudgetTotals:
SELECT b.month, g.is_income, CAST(IFNULL(SUM(b.amount), 0) AS INTEGER) AS total
FROM reflect_budgets b
JOIN categories c ON c.id = b.category AND c.tombstone = 0 AND c.hidden = 0
JOIN category_groups g ON g.id = c.cat_group AND g.tombstone = 0
WHERE b.month >= :start AND b.month <= :end AND (g.is_income = 1 OR g.hidden = 0)
GROUP BY b.month, g.is_income;

-- packages/desktop-client/src/spreadsheet/bindings.ts accountBalance()
monteCarloAccountBalances:
SELECT a.id AS account, IFNULL(SUM(t.amount), 0) AS total
FROM v_transactions_internal_alive t
JOIN accounts a ON a.id = t.account
WHERE t.is_parent = 0 AND a.id IN :accounts
GROUP BY a.id;
