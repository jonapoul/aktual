  <string name="reports_cash_flow_footer_title">How is cash flow calculated?</string>
  <string name="reports_cash_flow_footer">Cash flow shows the balance of your budgeted accounts over time, and the amount of expenses/income each day or month. Your budgeted accounts are considered to be "cash on hand", so this gives you a picture of how available money fluctuates.</string>

  <plurals name="reports_age_of_money_days">
