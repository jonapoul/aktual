{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "github>jonapoul/renovate-config:default.json5"
  ],
  "packageRules": [
    {
      // AGP versions are hardcoded in settings.gradle.kts as well as the version catalog, so
      // force them into the same group as the catalog's "agp" version ref
      "matchDepNames": [
        "com.android.application",
        "com.android.kotlin.multiplatform.library",
        "com.android.lint"
      ],
      "groupName": "agp"
    },
    {
      // Same for Kotlin
      "matchDepNames": [
        "org.jetbrains.kotlin.jvm",
        "org.jetbrains.kotlin.multiplatform",
        "org.jetbrains.kotlin.plugin.compose",
        "org.jetbrains.kotlin.plugin.serialization",
        "org.jetbrains.kotlin:kotlin-metadata-jvm"
      ],
      "groupName": "kotlin"
    }
  ]
}
