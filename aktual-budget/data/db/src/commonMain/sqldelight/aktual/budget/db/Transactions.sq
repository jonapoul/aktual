import aktual.budget.model.AccountId;
import aktual.budget.model.Amount;
import aktual.budget.model.CategoryId;
import aktual.budget.model.PayeeId;
import aktual.budget.model.ScheduleId;
import aktual.budget.model.TransactionId;
import kotlin.Boolean;
import kotlinx.datetime.LocalDate;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE IF NOT EXISTS transactions(
  id TEXT AS TransactionId PRIMARY KEY,
  isParent INTEGER AS Boolean DEFAULT 0,
  isChild INTEGER AS Boolean DEFAULT 0,
  acct TEXT AS AccountId,
  category TEXT AS CategoryId,
  amount INTEGER AS Amount,
  description TEXT AS PayeeId,
  notes TEXT,
  date INTEGER AS LocalDate,
  financial_id TEXT,
  type TEXT,
  location TEXT,
  error TEXT AS JsonObject,
  imported_description TEXT AS PayeeId,
  starting_balance_flag INTEGER AS Boolean DEFAULT 0,
  transferred_id TEXT AS TransactionId,
  sort_order REAL,
  tombstone INTEGER AS Boolean DEFAULT 0,
  cleared INTEGER AS Boolean DEFAULT 1,
  pending INTEGER AS Boolean DEFAULT 0,
  parent_id TEXT AS TransactionId,
  schedule TEXT AS ScheduleId,
  reconciled INTEGER AS Boolean DEFAULT 0,
  raw_synced_data TEXT
);

CREATE INDEX IF NOT EXISTS trans_category_date ON transactions(category, date);
CREATE INDEX IF NOT EXISTS trans_category ON transactions(category);
CREATE INDEX IF NOT EXISTS trans_date ON transactions(date);
CREATE INDEX IF NOT EXISTS trans_parent_id ON transactions(parent_id);
CREATE INDEX IF NOT EXISTS trans_sorted ON transactions(date DESC, starting_balance_flag, sort_order DESC, id);
CREATE INDEX IF NOT EXISTS idx_transactions_acct_tombstone ON transactions(acct, tombstone);
CREATE INDEX IF NOT EXISTS idx_transactions_schedule ON transactions(schedule);

CREATE VIEW IF NOT EXISTS v_transactions_internal AS
SELECT
  t.id,
  t.isParent AS is_parent,
  t.isChild AS is_child,
  CASE WHEN t.isChild = 0 THEN NULL ELSE t.parent_id END AS parent_id,
  t.acct AS account,
  CASE WHEN t.isParent = 1 THEN NULL ELSE cm.transferId END AS category,
  IFNULL(t.amount, 0) AS amount,
  pm.targetId AS payee,
  t.notes,
  t.date,
  t.financial_id AS imported_id,
  t.error,
  t.imported_description AS imported_payee,
  t.starting_balance_flag,
  t.transferred_id AS transfer_id,
  t.sort_order,
  t.cleared,
  t.reconciled,
  t.tombstone,
  t.schedule
FROM transactions t
LEFT JOIN category_mapping cm ON cm.id = t.category
LEFT JOIN payee_mapping pm ON pm.id = t.description
WHERE
  t.date IS NOT NULL AND
  t.acct IS NOT NULL AND
  (t.isChild = 0 OR t.parent_id IS NOT NULL);

CREATE VIEW IF NOT EXISTS v_transactions_internal_alive AS
SELECT
  vti.*
FROM v_transactions_internal vti
LEFT JOIN transactions t2 ON (vti.is_child = 1 AND t2.id = vti.parent_id)
WHERE IFNULL(vti.tombstone, 0) = 0 AND (vti.is_child = 0 OR t2.tombstone = 0);

CREATE VIEW IF NOT EXISTS v_transactions AS
SELECT
  vtia.id,
  vtia.is_parent,
  vtia.is_child,
  vtia.parent_id,
  a.id AS account,
  c.id AS category,
  vtia.amount,
  p.id AS payee,
  vtia.notes,
  vtia.date,
  vtia.imported_id,
  vtia.error,
  vtia.imported_payee,
  vtia.starting_balance_flag,
  vtia.transfer_id,
  vtia.sort_order,
  vtia.cleared,
  vtia.reconciled,
  vtia.tombstone,
  vtia.schedule
FROM v_transactions_internal_alive vtia
LEFT JOIN payees p ON (p.id = vtia.payee AND p.tombstone = 0)
LEFT JOIN categories c ON (c.id = vtia.category AND c.tombstone = 0)
LEFT JOIN accounts a ON (a.id = vtia.account AND a.tombstone = 0)
ORDER BY
  vtia.date DESC,
  vtia.starting_balance_flag,
  vtia.sort_order DESC,
  vtia.id;

insert:
INSERT INTO transactions VALUES ?;

getIds:
SELECT id FROM v_transactions ORDER BY date DESC;

-- Raw row, for the write path to inspect the stored columns
getRowById:
SELECT * FROM transactions WHERE id = ?;

-- packages/loot-core/src/server/transactions/index.ts idsWithChildren(). Upstream reads
-- v_transactions_internal, whose computed parent_id SQLDelight can't type, so this inlines its filters
getChildIds:
SELECT id FROM transactions
  WHERE parent_id IN ? AND
    (isChild IS NULL OR isChild != 0) AND
    date IS NOT NULL AND
    acct IS NOT NULL;

-- Paginated queries for Paging 3. Sorted as upstream's v_transactions, so ties within a day keep a
-- stable order across pages. The whole and per-account lists hide split children, which hang off
-- their parent's row, as upstream's mobile lists do
--
-- needsCategory is upstream's 'uncategorized' account filter (desktop-client/src/queries/index.ts),
-- minus starting balances: an on-budget, non-parent transaction with no category, which isn't a
-- transfer to another on-budget account. The same predicate is repeated in the uncategorised
-- queries below, so keep them in step
--
-- offBudget and isTransfer are what upstream's mobile list labels a row with in place of its
-- category: specialCategory in desktop-client/src/components/mobile/transactions/TransactionListItem.tsx
--
-- error is set on a split parent whose parts don't add up to its amount
getPaged:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  CASE WHEN
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1)
  THEN 1 ELSE 0 END AS needsCategory,
  CASE WHEN a.offbudget = 1 THEN 1 ELSE 0 END AS offBudget,
  CASE WHEN ta.id IS NOT NULL AND IFNULL(ta.offbudget, 0) = 0 THEN 1 ELSE 0 END AS isTransfer
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT :limit OFFSET :offset;

getByAccountPaged:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  CASE WHEN
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1)
  THEN 1 ELSE 0 END AS needsCategory,
  CASE WHEN a.offbudget = 1 THEN 1 ELSE 0 END AS offBudget,
  CASE WHEN ta.id IS NOT NULL AND IFNULL(ta.offbudget, 0) = 0 THEN 1 ELSE 0 END AS isTransfer
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE a.id = :account AND IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT :limit OFFSET :offset;

-- A group of accounts as upstream's sidebar lists them: on or off budget, which only cover open
-- accounts, or closed, where :offBudget is null. accountFilter() in desktop-client/src/queries/index.ts
getByGroupPaged:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  CASE WHEN
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1)
  THEN 1 ELSE 0 END AS needsCategory,
  CASE WHEN a.offbudget = 1 THEN 1 ELSE 0 END AS offBudget,
  CASE WHEN ta.id IS NOT NULL AND IFNULL(ta.offbudget, 0) = 0 THEN 1 ELSE 0 END AS isTransfer
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE
    a.closed = :closed AND
    (:offBudget IS NULL OR a.offbudget = :offBudget) AND
    IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT :limit OFFSET :offset;

getUncategorisedPaged:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  1 AS needsCategory,
  0 AS offBudget,
  0 AS isTransfer
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1) AND
    (:account IS NULL OR a.id = :account)
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT :limit OFFSET :offset;

-- A category's on-budget transactions between two dates, with split parts as their own rows as
-- upstream's mobile category page shows them. A subset of their accounts, so there's no balance
getByCategoryPaged:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  0 AS needsCategory,
  0 AS offBudget,
  0 AS isTransfer
  FROM v_transactions_internal_alive AS vt
  INNER JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE
    a.offbudget = 0 AND
    c.id = :category AND
    IFNULL(vt.is_parent, 0) = 0 AND
    vt.date BETWEEN :fromDate AND :toDate AND
    (:account IS NULL OR a.id = :account)
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT :limit OFFSET :offset;

countUncategorised:
SELECT COUNT(*)
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1);

getByIds:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  CASE WHEN
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1)
  THEN 1 ELSE 0 END AS needsCategory,
  CASE WHEN a.offbudget = 1 THEN 1 ELSE 0 END AS offBudget,
  CASE WHEN ta.id IS NOT NULL AND IFNULL(ta.offbudget, 0) = 0 THEN 1 ELSE 0 END AS isTransfer
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE vt.id IN :ids;

-- The live children of these split parents, in the order they were entered. As with getChildIds,
-- parent_id comes from the table since SQLDelight can't type the view's
getChildrenOf:
SELECT
  vt.id,
  vt.date,
  a.name AS accountName,
  p.name AS payeeName,
  ta.name AS transferAccountName,
  vt.notes,
  c.name AS categoryName,
  vt.amount,
  vt.is_parent AS isParent,
  vt.is_child AS isChild,
  vt.error,
  CASE WHEN
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1)
  THEN 1 ELSE 0 END AS needsCategory,
  CASE WHEN a.offbudget = 1 THEN 1 ELSE 0 END AS offBudget,
  CASE WHEN ta.id IS NOT NULL AND IFNULL(ta.offbudget, 0) = 0 THEN 1 ELSE 0 END AS isTransfer,
  t.parent_id AS parentId
  FROM v_transactions_internal_alive AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE t.parent_id IN :parents AND vt.is_child = 1
  ORDER BY vt.sort_order DESC, vt.id;

-- Balance after the transaction at :offset in getPaged's order, i.e. the sum of it and everything
-- older. Split children are skipped since their parent's amount already covers them, as upstream's
-- balance queries do with splits: 'none'. They're dropped before the offset, which has to count
-- the same rows as the paged queries
balanceFromOffset:
SELECT IFNULL(SUM(amount), 0) FROM (
  SELECT vt.amount
  FROM v_transactions_internal_alive AS vt
  WHERE IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT -1 OFFSET :offset
);

balanceFromOffsetByAccount:
SELECT IFNULL(SUM(amount), 0) FROM (
  SELECT vt.amount
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  WHERE a.id = :account AND IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT -1 OFFSET :offset
);

balanceFromOffsetByGroup:
SELECT IFNULL(SUM(amount), 0) FROM (
  SELECT vt.amount
  FROM v_transactions_internal_alive AS vt
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  WHERE
    a.closed = :closed AND
    (:offBudget IS NULL OR a.offbudget = :offBudget) AND
    IFNULL(vt.is_child, 0) = 0
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id
  LIMIT -1 OFFSET :offset
);

-- id + notes for every live transaction, for in-memory #tag filtering (no SQL regex available).
-- parentId is only meaningful when isChild is set
getIdsAndNotes:
SELECT vt.id, vt.notes, vt.is_child AS isChild, t.parent_id AS parentId
  FROM v_transactions AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id;

getIdsAndNotesByAccount:
SELECT vt.id, vt.notes, vt.is_child AS isChild, t.parent_id AS parentId
  FROM v_transactions AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  WHERE vt.account = :account
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id;

getIdsAndNotesByGroup:
SELECT vt.id, vt.notes, vt.is_child AS isChild, t.parent_id AS parentId
  FROM v_transactions AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  INNER JOIN accounts AS a ON a.id = vt.account
  WHERE a.closed = :closed AND (:offBudget IS NULL OR a.offbudget = :offBudget)
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id;

getUncategorisedIdsAndNotes:
SELECT vt.id, vt.notes, vt.is_child AS isChild, t.parent_id AS parentId
  FROM v_transactions_internal_alive AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  LEFT JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  LEFT JOIN payees AS p ON (p.id = vt.payee AND p.tombstone = 0)
  LEFT JOIN accounts AS ta ON ta.id = p.transfer_acct
  WHERE
    a.offbudget = 0 AND
    c.id IS NULL AND
    IFNULL(vt.is_parent, 0) = 0 AND
    IFNULL(vt.starting_balance_flag, 0) = 0 AND
    (p.transfer_acct IS NULL OR ta.offbudget = 1) AND
    (:account IS NULL OR a.id = :account)
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id;

getIdsAndNotesByCategory:
SELECT vt.id, vt.notes, vt.is_child AS isChild, t.parent_id AS parentId
  FROM v_transactions_internal_alive AS vt
  INNER JOIN transactions AS t ON t.id = vt.id
  INNER JOIN categories AS c ON (c.id = vt.category AND c.tombstone = 0)
  LEFT JOIN accounts AS a ON (a.id = vt.account AND a.tombstone = 0)
  WHERE
    a.offbudget = 0 AND
    c.id = :category AND
    IFNULL(vt.is_parent, 0) = 0 AND
    vt.date BETWEEN :fromDate AND :toDate AND
    (:account IS NULL OR a.id = :account)
  ORDER BY vt.date DESC, vt.starting_balance_flag, vt.sort_order DESC, vt.id;

-- notes of every live transaction containing a '#', for aggregating per-tag transaction counts
notesContainingHash:
SELECT notes FROM v_transactions WHERE notes LIKE '%#%';

getIdsCount:
SELECT COUNT(*) FROM v_transactions;

-- Bulk variant: fetches all (schedule, date) pairs on or after fromDate.
-- Callers group by schedule and take max(date) to check per-schedule thresholds in Kotlin.
transactionDatesFromDate:
SELECT schedule, date
FROM transactions
WHERE schedule IS NOT NULL AND tombstone = 0 AND date >= :fromDate;
